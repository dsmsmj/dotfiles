# Image Designer 环境变量配置

# MiniMax API（文本 OpenAI 兼容、原生多模态视觉、文生图/图生图）
# 控制台：https://platform.minimax.io/
MINIMAX_API_KEY=

# OpenAI 兼容基址（默认国际节点；中国大陆可使用 https://api.minimaxi.com/v1）
# MINIMAX_BASE_URL=https://api.minimax.io/v1

# 可选：覆盖默认模型
# MINIMAX_TEXT_MODEL=MiniMax-M2.5
# MINIMAX_VISION_MODEL=MiniMax-Text-01
# MINIMAX_T2I_MODEL=image-01
# MINIMAX_I2I_MODEL=image-01

# Unsplash API 密钥（用于搜索参考图片）
# 获取地址：https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Pixabay API 密钥（用于搜索参考图片）
# 获取地址：https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- Session / acpx ---
# acpx 队列运行时注入：JSON 字符串，须含 acp_session_id；可选 userRequest、taskSummary、documentPath、jobId 等
# ACPX_QUEUE_OWNER_PAYLOAD={"acp_session_id":"8685070d-651d-4bd1-b8ee-89bbd378a274","jobId":"..."}

# 用户需求一句话（写入 sessions/.../session_context.json；也可放在 payload.userRequest）
# ACPX_USER_REQUEST=根据某文档设计一组海报
